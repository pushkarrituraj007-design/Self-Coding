#------------------------------------------Student Management System--------------------------------------------------------------------
class Student:
    def __init__(self, student_id, name, age, marks):
        self.student_id = student_id
        self.name = name
        self.age = age
        self.marks = marks

    def display(self):
        print(f"ID: {self.student_id}")
        print(f"Name: {self.name}")
        print(f"Age: {self.age}")
        print(f"Marks: {self.marks}")


class StudentManagementSystem:
    def __init__(self):
        self.students = []

#-----------------------------------------------Add A New Student Details-----------------------------------------------------------------
    def add_student(self):
        student_id = input("Enter Student ID: ")

        for student in self.students:    #Check whether the student id already exists or not (CHOICE)
            if student.student_id == student_id:
                print("Student ID already exists!")
                return

        name = input("Enter Name:")
        age = int(input("Enter Age:"))
        marks = float(input("Enter Marks:"))

        student = Student(student_id, name, age, marks)
        self.students.append(student)
        print("Student details added successfully!")

#------------------------------------------------View Student Records-----------------------------------------------------------------------

                               
    def view_students(self):   
        if not self.students:
            print("No students found.")
            return

        print("\nStudent Records")
        for student in self.students:
            student.display()

    def search_student(self):
        student_id = input("Enter the Student ID to search: ")

        for student in self.students:
            if student.student_id == student_id:
                print("Student Found:")
                student.display()
                return

        print("Student Details Not Found!!!!!")

#-----------------------------------------------------Update Student Marks-----------------------------------------------------------------------
    def update_marks(self):
        student_id = input("Enter the Student ID: ")

        for student in self.students:
            if student.student_id == student_id:
                new_marks = float(input("Enter New Marks: "))
                student.marks = new_marks
                print("Marks updated successfully!")
                return

        print("Student Details Not Found!!!!!")

#------------------------------------------------------Delete Student Record---------------------------------------------------------------
    
    def delete_student(self):
        student_id = input("Enter the Student ID to delete: ")
        for student in self.students:
            if student.student_id == student_id:
                self.students.remove(student)
                print("Student Details Deleted Successfully!!!")
                return

        print("Student Details Not Found!!!!!")

#---------------------------------------------Display Student with Highest Marks-------------------------------------------------

    def highest_marks_student(self):
        if not self.students:
            print("No students available.")
            return

        top_student = max(self.students, key=lambda student: student.marks)

        print("\nStudent with Highest Marks")
        print("=" * 30)
        top_student.display()


stu_man_sys = StudentManagementSystem()

while True:
    print("===== STUDENT MANAGEMENT SYSTEM =====\n")
    print("1. Add New Student Details:")
    print("2. View All Students Details:")
    print("3. Search Student by User ID:")
    print("4. Update Student Marks:")
    print("5. Delete Student Record:")
    print("6. Display Student with Highest Marks:")
    print("7. Exit:")

    choice = input("Enter your choice: ")

    if choice == "1":
        stu_man_sys.add_student()
    elif choice == "2":
        stu_man_sys.view_students()
    elif choice == "3":
        stu_man_sys.search_student()
    elif choice == "4":
        stu_man_sys.update_marks()
    elif choice == "5":
        stu_man_sys.delete_student()
    elif choice == "6":
        stu_man_sys.highest_marks_student()
    elif choice == "7":
        print("Exiting the Student Management System. Goodbye!")
        break
    else:
        print("Invalid choice! Please Check Your Input.")
